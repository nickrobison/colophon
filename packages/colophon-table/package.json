{
  "name": "@nickrobison/colophon-table",
  "version": "0.1.0",
  "description": "Colophon data tables — dense, comparison-focused ledger tables.",
  "keywords": [
    "design-system",
    "table",
    "tanstack-table"
  ],
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./components.css": "./src/components.css",
    "./table-tokens.css": "./src/table-tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false && vite build",
    "test": "vitest run --coverage",
    "lint": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6409",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --browsers chromium",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -P \"http-server storybook-static --port 6409 --silent\" \"wait-on tcp:127.0.0.1:6409 && test-storybook --url http://127.0.0.1:6409 {@}\" --",
    "playwright:install": "playwright install --with-deps chromium",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-table": "9.2.6",
    "lucide-react": "^0.469.0",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.22.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.5",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "storybook": "^8.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  },
  "peerDependencies": {
    "@nickrobison/colophon": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
