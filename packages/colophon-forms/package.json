{
  "name": "@nickrobison/colophon-forms",
  "version": "0.1.0",
  "description": "Colophon forms — labeled fields with focus + error states (red + icon + text).",
  "keywords": [
    "design-system",
    "forms",
    "tanstack-intent"
  ],
  "license": "MIT",
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./components.css": "./src/components.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false && vite build",
    "test": "vitest run --coverage",
    "lint": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --browsers chromium",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -P \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006 {@}\" --",
    "playwright:install": "playwright install --with-deps firefox",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.11.0",
    "lucide-react": "catalog:",
    "react-aria-components": "catalog:",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/test-runner": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "catalog:",
    "http-server": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wait-on": "catalog:"
  },
  "peerDependencies": {
    "@nickrobison/colophon": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
