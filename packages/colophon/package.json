{
  "name": "@nickrobison/colophon",
  "version": "0.1.0",
  "description": "Colophon design system \u2014 calm, dense, typographic scholar's ledger. Pure react-aria + Tailwind v4.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "tanstack-intent",
    "design-system",
    "react-aria",
    "tailwind"
  ],
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./foundation.css": "./src/foundation/tokens.css",
    "./components.css": "./src/components.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false 2>&1 || true; vite build",
    "test": "vitest run --coverage",
    "lint": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/newsreader": "^5.2.5",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.15",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.469.0",
    "storybook": "^8.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}