{
  "name": "@nickrobison/colophon",
  "version": "0.1.0",
  "description": "Colophon design system — calm, dense, typographic scholar's ledger. Pure react-aria + Tailwind v4.",
  "keywords": [
    "design-system",
    "react-aria",
    "tailwind",
    "tanstack-intent"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./foundation.css": "./src/foundation/tokens.css",
    "./components.css": "./src/components.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false 2>&1 || true; vite build",
    "test": "vitest run --coverage",
    "lint": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --browsers firefox webkit",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -P \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006 {@}\" --",
    "playwright:install": "playwright install --with-deps firefox webkit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/newsreader": "^5.2.5",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.22.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.5",
    "http-server": "^14.1.1",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.469.0",
    "playwright": "^1.63.0",
    "storybook": "^8.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.4",
    "wait-on": "^9.5.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
