{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {},
  "sortPackageJson": {},
  "sortTailwindcss": {
    "stylesheet": "./packages/colophon/src/foundation/tokens.css",
    "functions": ["clsx", "cn", "cx", "tw", "twMerge", "composeRenderProps"]
  },
  "ignorePatterns": ["pnpm-lock.yaml", "**/CHANGELOG.md"]
}
