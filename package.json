{
  "name": "@nickrobison/colophon-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "oxlint --deny-warnings && pnpm -r lint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "storybook": "pnpm --filter @nickrobison/colophon storybook",
    "test:storybook": "pnpm --filter @nickrobison/colophon test-storybook",
    "storybook:demo": "pnpm --filter @nickrobison/colophon-demo storybook",
    "demo": "pnpm --filter @nickrobison/colophon-demo dev",
    "validate:skills": "intent validate ./packages/colophon/skills"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tanstack/intent": "^0.5.6",
    "@vitejs/plugin-react": "catalog:",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2"
}
